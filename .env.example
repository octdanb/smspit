# Copy to .env for local dev / compose. Real environment variables always win.
# See docs/configuration.md for the full reference.

# Port the server listens on.
# SMSPIT_PORT=8025

# SQLite database file (mount its directory to persist across restarts).
# SMSPIT_DB_PATH=./data/smspit.db

# Require a token for the dashboard + internal API (recommended on shared hosts).
# SMSPIT_DASHBOARD_TOKEN=

# Allow the server to fetch MediaUrls that resolve to private/loopback
# addresses. Off by default (SSRF protection); enable only for single-machine
# local dev that serves media from localhost.
# SMSPIT_ALLOW_PRIVATE_MEDIA=

# Build version shown in the dashboard (stamped at image build time).
# SMSPIT_VERSION=dev
